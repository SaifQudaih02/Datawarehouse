   "cell_type": "code",
   "source": [
    "cc.set_connectionProfile(\"VeloDB\")\n",
    "# Step 2: Read the rides data\n",
    "df_operational_rides = spark.read \\\n",
    "    .format(\"jdbc\") \\\n",
    "    .option(\"url\", cc.create_jdbc()) \\\n",
    "    .option(\"driver\" , cc.get_Property(\"driver\")) \\\n",
    "    .option(\"dbtable\", \"rides\") \\\n",
    "    .option(\"user\", cc.get_Property(\"username\")) \\\n",
    "    .option(\"password\", cc.get_Property(\"password\")) \\\n",
    "    .option(\"partitionColumn\", \"rideId\") \\\n",
    "    .option(\"numPartitions\", 4) \\\n",
    "    .option(\"lowerBound\", 0) \\\n",
    "    .option(\"upperBound\", 1000) \\\n",
    "    .load()\n",
    "\n",
    "# Step 3:  Load the JSON files from the weather folder\n",
    "df_weather = spark.read.json(\"./weather/\", multiLine=True)\n",
    "\n",
    "# Flatten the weather data\n",
    "df_weather_flat = df_weather.withColumn(\"weather_time\", from_unixtime(col(\"dt\"))) \\\n",
    "    .withColumn(\"weather_hour\", hour(col(\"weather_time\"))) \\\n",
    "    .select(\n",
    "    col(\"zipCode\"),\n",
    "    col(\"weather_hour\"),\n",
    "    col(\"weather.main\").getItem(0).alias(\"weather_type\")\n",
    ")\n",
    "\n",
    "# df_weather_flat.show()\n",
    "\n",
    "# Step 4: Preprocess the rides data\n",
    "df_operational_rides = df_operational_rides.withColumn('ride_start_hour', hour(date_trunc('hour', col('starttime'))))\n",
    "\n",
    "# Calculate the ride duration\n",
    "df_operational_rides = df_operational_rides.withColumn(\n",
    "    \"ride_duration\",\n",
    "    (col(\"endtime\").cast(\"long\") - col(\"starttime\").cast(\"long\")) / 60)\n",
    "\n",
    "\n",
    "# Step 5: Join rides with weather data\n",
    "df_factRide = df_operational_rides.join(\n",
    "    df_weather_flat,\n",
    "    (df_operational_rides[\"ride_start_hour\"].cast('INT') == df_weather_flat[\"weather_hour\"].cast('INT')) &\n",
    "    (df_operational_rides[\"startlockid\"] == df_weather_flat[\"zipCode\"]),\n",
    "    \"left\"\n",
    ")\n",
    "\n",
    "# Handle cases where weather data isn't available\n",
    "df_factRide = df_factRide.withColumn(\n",
    "    \"weather_type\",\n",
    "    when(col(\"weather_type\").isNull(), lit(\"unknown\")).otherwise(col(\"weather_type\"))\n",
    ")\n",
    "\n",
    "# Step 6: Select necessary columns for factRide\n",
    "df_factRide = df_factRide.select(\n",
    "    \"rideid\",\n",
    "    \"startpoint\",\n",
    "    \"endpoint\",\n",
    "    \"starttime\",\n",
    "    \"endtime\",\n",
    "    \"vehicleid\",\n",
    "    \"subscriptionid\",\n",
    "    \"startlockid\",\n",
    "    \"endlockid\",\n",
    "    \"ride_duration\",\n",
    "    \"ride_start_hour\",\n",
    "    \"weather_type\"\n",
    ")\n",
    "\n",
    "# Display the factRide DataFrame\n",
    "df_factRide.show()\n",
    "    "
   ],
